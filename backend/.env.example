# Database
DATABASE_URL=postgresql+asyncpg://aiscribe:password@localhost:5432/aiscribe

# Security
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ASR Engines
# Azure Speech (optional for streaming ASR)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast

# Whisper Settings
WHISPER_MODEL=medium  # tiny, base, small, medium, large-v2, large-v3
WHISPER_DEVICE=cpu  # cpu or cuda
WHISPER_COMPUTE_TYPE=int8  # int8, int8_float16, float16

# Storage
STORAGE_BACKEND=local  # local, s3, azure, gcs
STORAGE_PATH=/var/aiscribe/audio
# For S3-compatible
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=aiscribe-audio
S3_REGION=ap-southeast-2
# For Azure Blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=audio
# For GCS
GCS_BUCKET_NAME=aiscribe-audio
GCS_CREDENTIALS_PATH=/path/to/credentials.json

# Compliance & Security
AU_DATA_RESIDENCY=true
ENCRYPTION_KEY_ID=default-key
AUDIO_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=2555  # 7 years
ENABLE_PHI_REDACTION=false
ENABLE_LOCAL_ONLY_MODE=true

# OAuth/SSO (Microsoft Entra)
OAUTH_ENABLED=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TENANT_ID=
OAUTH_AUTHORITY=https://login.microsoftonline.com/{tenant_id}
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-domain.com.au

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Medical NER
ENABLE_MEDICAL_NER=true
SPACY_MODEL=en_core_web_sm  # or en_core_sci_md for medical

# Diarization
ENABLE_DIARIZATION=true
PYANNOTE_AUTH_TOKEN=  # HuggingFace token for pyannote models

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=  # sk_test_... or sk_live_...
STRIPE_PUBLISHABLE_KEY=  # pk_test_... or pk_live_...
STRIPE_WEBHOOK_SECRET=  # whsec_...
